diff --git a/main/xiaozhi-server/core/utils/open_meteo_weather.py b/main/xiaozhi-server/core/utils/open_meteo_weather.py
new file mode 100644
--- /dev/null
+++ b/main/xiaozhi-server/core/utils/open_meteo_weather.py
@@ -0,0 +1,67 @@
+"""Keyless personal-use weather provider. Source: https://open-meteo.com/en/docs."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+
+import httpx
+
+
+WMO = {
+    0: "晴", 1: "大部晴朗", 2: "局部多云", 3: "阴", 45: "雾", 48: "雾凇",
+    51: "小毛毛雨", 53: "中毛毛雨", 55: "大毛毛雨", 56: "轻微冻毛毛雨", 57: "冻毛毛雨",
+    61: "小雨", 63: "中雨", 65: "大雨", 66: "轻微冻雨", 67: "冻雨",
+    71: "小雪", 73: "中雪", 75: "大雪", 77: "米雪", 80: "小阵雨", 81: "中阵雨",
+    82: "强阵雨", 85: "小阵雪", 86: "大阵雪", 95: "雷暴", 96: "雷暴伴小冰雹", 99: "雷暴伴大冰雹",
+}
+
+
+def format_report(city, data):
+    """Require dated current data; never describe old/malformed output as live weather."""
+    current, daily = data["current"], data["daily"]
+    tz = timezone(timedelta(seconds=int(data["utc_offset_seconds"])))
+    valid_time = datetime.fromisoformat(current["time"]).replace(tzinfo=tz)
+    if abs((datetime.now(tz) - valid_time).total_seconds()) > 7200:
+        raise ValueError("weather data is not current")
+    temperature = float(current["temperature_2m"])
+    lines = [
+        f"您查询的位置是：{city}",
+        f"数据有效时间：{current['time']}（{data['timezone']}）",
+        f"当前天气: {WMO.get(current['weather_code'], '天气代码'+str(current['weather_code']))}，气温{temperature:g}℃，"
+        f"体感{float(current['apparent_temperature']):g}℃，湿度{current['relative_humidity_2m']}%，"
+        f"风速{current['wind_speed_10m']}公里/小时。",
+        "未来7天预报：",
+    ]
+    if not daily["time"]:
+        raise ValueError("missing forecast")
+    for i, day in enumerate(daily["time"]):
+        low, high = daily["temperature_2m_min"][i], daily["temperature_2m_max"][i]
+        if low is None or high is None:
+            raise ValueError("missing forecast temperatures")
+        lines.append(f"{day}: {WMO.get(daily['weather_code'][i], '天气状况未知')}，气温{low}~{high}℃，降水概率{daily['precipitation_probability_max'][i]}%。")
+    lines.append("数据来源：Open-Meteo（https://open-meteo.com/），当前条件来自更新的气象模型，非现场气象站实测。按数据回答，不要编造；默认简短播报今天，用户问明天再介绍明天。")
+    return "\n".join(lines)
+
+
+async def _fetch(location):
+    async with httpx.AsyncClient(timeout=httpx.Timeout(6.0, connect=3.0), follow_redirects=False) as client:
+        if location in ("北京", "北京市"):
+            city, latitude, longitude = "北京", 39.9075, 116.39723
+        else:
+            response = await client.get("https://geocoding-api.open-meteo.com/v1/search", params={"name": location, "count": 5, "language": "zh"})
+            response.raise_for_status()
+            matches = response.json().get("results") or []
+            if not matches:
+                raise ValueError("location not resolved")
+            match = matches[0]
+            city, latitude, longitude = match["name"], match["latitude"], match["longitude"]
+        response = await client.get("https://api.open-meteo.com/v1/forecast", params={
+            "latitude": latitude, "longitude": longitude,
+            "current": "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",
+            "daily": "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",
+            "timezone": "auto", "forecast_days": 7,
+        })
+        response.raise_for_status()
+        return format_report(city, response.json())
+
+
+async def fetch_open_meteo_report(location):
+    return await asyncio.wait_for(_fetch(location), timeout=12)

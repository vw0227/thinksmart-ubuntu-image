+def weather_lookup_requested(dialogue, functions):
+    """Route explicit Chinese weather lookups, not capability questions or tool replies."""
+    if not dialogue or dialogue[-1].get("role") != "user":
+        return False
+    if not any(t.get("function", {}).get("name") == "get_weather" for t in functions or []):
+        return False
+    text = dialogue[-1].get("content")
+    if not isinstance(text, str):
+        return False
+    try:
+        structured = json.loads(text)
+        if isinstance(structured, dict):
+            text = structured.get("content", "")
+    except (ValueError, TypeError):
+        pass
+    if not isinstance(text, str) or "天气" not in text:
+        return False
+    if any(word in text for word in ("为什么", "怎么设置", "怎么配置", "插件", "接口", "工具", "修复", "联网", "不能查", "不要查", "别查", "不查")):
+        return False
+    markers = ("今天", "明天", "后天", "现在", "目前", "未来", "这周", "周末", "天气怎么样", "天气如何", "什么天气", "查天气", "查一下", "查下")
+    return any(word in text for word in markers) or bool(re.fullmatch(r"[\u4e00-\u9fffA-Za-z· ]{2,24}天气[？?。！!]*", text.strip()))
+
